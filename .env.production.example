# ==============================================================================
# PROFILE 3: PRODUCTION CLOUD DEPLOYMENT PROFILE
# Hardened configuration for Render, Railway, AWS ECS, GCP Cloud Run, or Kubernetes
# ==============================================================================

# Managed PostgreSQL (e.g. Supabase, AWS RDS, Neon, or Render PostgreSQL with pgvector)
# Must use SSL and connection pooling where applicable:
DATABASE_URL="postgresql://db_user:SUPER_SECURE_PASSWORD@db-host.internal:5432/employee_onboarding?sslmode=require&schema=public"
DIRECT_URL="postgresql://db_user:SUPER_SECURE_PASSWORD@db-host.internal:5432/employee_onboarding?sslmode=require&schema=public"

NODE_ENV=production
PORT=4000
# Production Origin (single origin or comma-separated origins, e.g. your custom domain or Render URL)
CORS_ORIGIN="https://employee-onboarding-du20.onrender.com"
LOG_LEVEL=info

# Cryptographically random 64-character JWT secrets (e.g. openssl rand -hex 32)
# NEVER reuse local secrets or commit these values to Git!
JWT_ACCESS_SECRET="GENERATE_UNIQUE_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="GENERATE_UNIQUE_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=employee-onboarding
JWT_AUDIENCE=employee-onboarding-api
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Enterprise OIDC Identity Provider (Keycloak / Okta / Azure AD / Auth0)
# Public HTTPS URL reachable by the production container and end users:
OIDC_ISSUER_URL="https://sso.yourcompany.com/realms/employee-onboarding"
OIDC_CLIENT_ID="employee-onboarding-app"
OIDC_CLIENT_SECRET="PRODUCTION_OIDC_CLIENT_SECRET"
OIDC_REDIRECT_URI="https://employee-onboarding-du20.onrender.com/api/v1/auth/oidc/callback"
OIDC_SCOPES="openid profile email"

# Keycloak Admin API Client (Service Account for employee invitation and SMTP activation)
KEYCLOAK_ADMIN_CLIENT_ID="employee-onboarding-provisioner"
KEYCLOAK_ADMIN_CLIENT_SECRET="PRODUCTION_PROVISIONER_SECRET"

# Strict Security Controls (hard-enforced in production)
DEV_AUTH_BYPASS=false
SEED_REFERENCE_DATA=false
SEED_DEMO_DATA=false

# LLM Intelligence Engine
# Provider options: 'gemini', 'ollama', or 'disabled' (zero-AI deterministic fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY="PRODUCTION_GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
CHAT_PROVIDER_TIMEOUT_MS=10000

# Persistent Document Storage (mount a persistent cloud volume or S3-backed volume)
DOCUMENT_STORAGE_DIR=/app/.data/documents
