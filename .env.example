# ---------------------------------------------------------------------------
# Database (Neon). Copy to .env and paste your Neon connection string.
# Neon -> Dashboard -> Connection Details -> "Prisma" tab.
# ---------------------------------------------------------------------------
# DATABASE_URL  -> the POOLED endpoint (hostname contains "-pooler").
#                  Used by the running app; PgBouncer keeps the connection
#                  count sane on a serverless plan.
# DIRECT_URL    -> the SAME host WITHOUT "-pooler".
#                  Prisma needs a direct connection for `db push` and
#                  `migrate`: DDL and advisory locks cannot go through a
#                  transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-change-me-please
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=employee-onboarding
JWT_AUDIENCE=employee-onboarding-api
BCRYPT_ROUNDS=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Dev-only auth bypass so teammates can build routes before login exists.
# MUST be false in CI and production; the API refuses to boot otherwise.
# Usage:  curl -H "x-dev-user: hr.admin@demo.io" ...
# ---------------------------------------------------------------------------
DEV_AUTH_BYPASS=true

# ---------------------------------------------------------------------------
# LLM (AI/ML dev)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text
