# Pooled application connection and direct migration connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_onboarding?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/employee_onboarding?schema=public"
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Replace both with different random secrets before deployment.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-change-me-please
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=employee-onboarding
JWT_AUDIENCE=employee-onboarding-api
BCRYPT_ROUNDS=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Leave all four OIDC values blank to run API/build checks without SSO.
# For local Keycloak, fill these with the realm issuer, client ID, secret and callback.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Local development Keycloak only (docker compose --profile local-identity).
# Change the password before starting Keycloak; never reuse this for deployment.
KEYCLOAK_DEV_ADMIN_USERNAME=admin
KEYCLOAK_DEV_ADMIN_PASSWORD=local-admin-change-me
# Optional server-side Keycloak Admin API service account used by HR employee invitations.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
DEV_AUTH_BYPASS=false
SEED_REFERENCE_DATA=false
BOOTSTRAP_HR_EMAIL=

# Select ollama, gemini or disabled. Failures fall back to baseline templates.
LLM_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=0
CHAT_PROVIDER_TIMEOUT_MS=8000

# Mount this directory on persistent storage when deploying.
DOCUMENT_STORAGE_DIR=.data/documents
