# ==============================================================================
# PROFILE 2: LOCAL ENTERPRISE KEYCLOAK OIDC PROFILE
# Full local environment with Keycloak 26 OIDC Code Flow + PKCE authentication
# ==============================================================================

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_onboarding?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/employee_onboarding?schema=public"

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# JWT Secrets for local session management (minimum 32 characters)
JWT_ACCESS_SECRET=local-keycloak-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=local-keycloak-refresh-secret-minimum-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=employee-onboarding
JWT_AUDIENCE=employee-onboarding-api
BCRYPT_ROUNDS=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Keycloak Local OIDC Configuration
# Start Keycloak via: docker compose --profile local-identity up -d keycloak
OIDC_ISSUER_URL=http://localhost:8080/realms/employee-onboarding
OIDC_CLIENT_ID=employee-onboarding-api
OIDC_CLIENT_SECRET=replace-with-client-secret-from-keycloak-admin
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email

# Keycloak Local Admin Bootstrapping
KEYCLOAK_DEV_ADMIN_USERNAME=admin
KEYCLOAK_DEV_ADMIN_PASSWORD=local-admin-change-me

# Server-Side Provisioner Client (for sending account activation invites via SMTP)
KEYCLOAK_ADMIN_CLIENT_ID=employee-onboarding-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-provisioner-client-secret

DEV_AUTH_BYPASS=false
SEED_REFERENCE_DATA=true
SEED_DEMO_DATA=true
BOOTSTRAP_HR_EMAIL=asha.hr@clyora

# AI Provider Settings
LLM_PROVIDER=gemini
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

DOCUMENT_STORAGE_DIR=.data/documents
