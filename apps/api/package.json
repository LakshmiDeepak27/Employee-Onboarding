{
  "name": "@eo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "openapi": "tsx src/scripts/emit-openapi.ts",
    "openapi:check": "tsx src/scripts/emit-openapi.ts --check",
    "db:generate": "node scripts/with-root-env.cjs prisma generate",
    "db:push": "node scripts/with-root-env.cjs prisma db push",
    "db:migrate": "node scripts/with-root-env.cjs prisma migrate dev",
    "db:studio": "node scripts/with-root-env.cjs prisma studio",
    "db:seed": "node scripts/with-root-env.cjs tsx prisma/seed.ts",
    "db:seed:reference": "node scripts/with-root-env.cjs tsx prisma/seed.ts --reference",
    "db:seed:templates": "node scripts/with-root-env.cjs tsx prisma/seed-templates.ts",
    "db:deploy": "node scripts/with-root-env.cjs prisma migrate deploy"
  },
  "dependencies": {
    "@eo/contracts": "*",
    "@google/genai": "^3.0.0",
    "@prisma/client": "6.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "bcryptjs": "^2.4.3",
    "prisma": "6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  }
}
